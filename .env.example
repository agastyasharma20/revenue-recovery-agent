# Copy this file to .env and fill in your own Razorpay TEST-MODE credentials.
# .env is already excluded via .gitignore -- never commit real keys.

# From Razorpay Dashboard -> Settings -> API Keys (make sure you're in Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The secret you choose when creating the webhook in
# Dashboard -> Settings -> Webhooks (subscribe to payment.failed and
# subscription.charged.failed). Razorpay signs every webhook body with this
# secret; webhook_server.py rejects any request whose signature doesn't match.
RAZORPAY_WEBHOOK_SECRET=

# Optional: enables LLM-refined diagnosis confidence/rationale
# (core/classifier.py) and Hinglish voice-script generation
# (core/voice_recovery.py). core/llm_client.py tries providers in this
# order and falls back automatically -- set either or both. If neither is
# set, the pipeline runs on rule-based diagnosis + template scripts only;
# this is expected and does not break anything.
GROQ_API_KEY=
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: real ops alerting (core/alerting.py) on a systemic incident, a
# case pausing for human approval, or an audit-chain integrity failure --
# any Slack-compatible incoming webhook URL. Not set = every alert call is
# a no-op, no network attempted; this is the expected default, not a
# degraded state. Create one: Slack -> Apps -> Incoming Webhooks.
SLACK_WEBHOOK_URL=
